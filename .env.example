# Copie para .env.local (ou configure no provedor de deploy) e preencha os valores.

# Banco de dados
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# E-mail (formulário de contato)
RESEND_API_KEY=
CONTACT_EMAIL=

# Chave de administrador: enviada como "Authorization: Bearer <chave>".
# Gere uma chave longa e aleatória, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=
